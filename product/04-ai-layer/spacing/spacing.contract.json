{
  "$schema": "ds-space-contract/1",
  "system": "ds",
  "prefix": "ds",
  "standard": "WCAG 2.2 AA",
  "densities": [
    "comfortable",
    "default",
    "compact"
  ],
  "defaultDensity": "default",
  "modeSwitching": {
    "css": "data-density=\"comfortable|default|compact\" on <html> or on any container; without it, the default density",
    "figma": "Set the Density collection mode (comfortable, default, compact) on a frame"
  },
  "densityRule": {
    "step": 1,
    "text": "Compact is one step down the scale from default and comfortable one step up, for every token; size.target.min never moves."
  },
