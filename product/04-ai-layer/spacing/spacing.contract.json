          "space.inline.lg"
        ],
        [
          "Groups in a toolbar or action bar",
          "space.inline.xl"
        ]
      ]
    },
    {
      "what": "Something people press",
      "question": "What is it?",
      "answers": [
        [
          "A button, input, select or tab",
          "size.control.height (as min-height)"
        ],
        [
          "An icon-only button",
          "size.control.height (min-width and min-height)"
        ],
        [
          "An icon next to the label inside a control",
          "size.control.icon-gap"
        ],
        [
          "A small mark people click: a checkbox, a close icon, a drag handle",
          "size.target.min (its hit area)"
        ]
      ]
    },
    {
      "what": "How dense the screen is",
      "question": "What kind of screen is it?",
      "answers": [
        [
          "Tables, dashboards, admin tools — people scan a lot at once",
          "data-density=\"compact\""
        ],
        [
          "Most product screens",
          "data-density=\"default\""
        ],
        [
          "Touch-first screens, onboarding, people who need bigger targets",
          "data-density=\"comfortable\""
        ],
        [
          "One dense part of a page, such as a table in a default page",
          "data-density=\"compact\" on that container"
        ]
      ]
    }
  ],
