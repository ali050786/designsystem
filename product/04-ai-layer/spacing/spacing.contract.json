    "targetEnhanced": 44,
    "minSpace": 2,
    "labelRoom": 4,
    "gridFrom": 8,
    "units": "px"
  },
  "build": {
    "ok": true,
    "tokens": 20,
    "checks": [
      {
        "id": "S1",
        "title": "Pointer targets ≥ 24×24px in every density",
        "status": "pass",
        "summary": "6/6 pass"
      },
      {
        "id": "S2",
        "title": "Comfortable density controls ≥ 44px",
        "status": "pass",
        "summary": "1/1 pass"
      },
      {
        "id": "S3",
        "title": "Density is one rule: every token moves the same number of steps along the scale (compact down, comfortable up); the target floor never moves",
        "status": "pass",
        "summary": "22/22 pass"
      },
      {
        "id": "S4",
        "title": "One ladder: sizes step up inside each family, and a size word is the same distance in every family, in every density",
        "status": "pass",
        "summary": "60/60 pass"
      },
      {
        "id": "S5",
        "title": "Nothing collapses: every space is at least 2px in every density",
        "status": "pass",
        "summary": "60/60 pass"
      },
      {
        "id": "S6",
        "title": "Controls fit their label in every density, with at least 4px above and below",
        "status": "pass",
        "summary": "3/3 pass"
      },
      {
        "id": "S7",
        "title": "The scale sits on a grid: 2px steps below 8px, the 4px grid from 8px up, always increasing",
        "status": "pass",
        "summary": "16/16 pass"
      },
      {
        "id": "S8",
        "title": "In code, spacing is px: when readers enlarge text, the text gets the room, not the margins",
        "status": "pass",
        "summary": "17/17 pass"
      }
    ]
  },
  "rules": [
    {
      "id": "SR-01",
      "rule": "Use a spacing token for every padding, margin and gap. Never px, rem or em values, and never Tailwind's own numeric scale (p-4, gap-2, mt-[13px]).",
      "why": "Tokens follow the density and stay on the scale; a hand-set 12px does neither and is never checked.",
      "wcag": "—"
    },
    {
      "id": "SR-02",
      "rule": "Pick the family by direction: space.inset.* for padding, space.stack.* for vertical gaps (row-gap, margin-top and -bottom), space.inline.* for horizontal gaps (column-gap, margin-left and -right).",
      "why": "A size word is the same distance in every family, so the family only records which way the space runs. That is what reviews and the checker read.",
      "wcag": "—"
    },
    {
      "id": "SR-03",
      "rule": "Pick the size by relationship: the more closely two things belong together, the smaller the space between them; space inside a group is always smaller than the space around it. When spacing shows a group, the markup groups it too (a list, a fieldset, a section with a heading).",
      "why": "People read grouping from distance before they read borders or headings. Screen-reader users get the same grouping only from the markup.",
      "wcag": "1.3.1"
    },
    {
      "id": "SR-04",
      "rule": "Density is a mode: set data-density on <html> or on a container (a dense table inside a default page). Never swap token names or write a .compact class to make something tighter.",
      "why": "The mode moves every token together and keeps targets and labels safe; a swapped name moves one value and breaks the ladder.",
      "wcag": "—"
    },
    {
      "id": "SR-05",
      "rule": "Every pointer target is at least 24×24px in every density. Controls use size.control.height; icon-only buttons are at least that square (min-width and min-height); small marks (a checkbox, a close icon, a drag handle) get a hit area of at least size.target.min.",
      "why": "People with tremors, on a moving bus or using a thumb miss small targets. 24px is the WCAG minimum.",
      "wcag": "2.5.8"
    },
    {
      "id": "SR-06",
      "rule": "Heights are minimums. Anything that holds text uses min-height (min-height: var(--…-size-control-height), Tailwind min-h-control), never height.",
      "why": "At 200% text a label needs twice its line height; a fixed 32px box cuts it off.",
      "wcag": "1.4.4, 1.4.12"
    },
    {
      "id": "SR-07",
      "rule": "Never use a primitive (space.4, --…-space-4) in a component. Use the semantic token for the job.",
      "why": "Primitives don't change with density, so that one space stays put when the rest of the screen tightens.",
      "wcag": "—"
    },
    {
      "id": "SR-08",
      "rule": "Never redefine a spacing token in app code (--…-space-inset-md: 10px). Change the engine config and build, so the change is checked.",
      "why": "An overridden variable skips every check and silently changes every component that uses it.",
      "wcag": "—"
    },
    {
      "id": "SR-09",
      "rule": "Never make space with empty elements: spacer divs, runs of <br> or &nbsp;.",
      "why": "They don't follow density, and screen readers may announce empty lines as \"blank\".",
      "wcag": "—"
    }
  ],
  "decisions": [
