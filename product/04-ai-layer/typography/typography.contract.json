{
  "$schema": "ds-type-contract/1",
  "system": "ds",
  "prefix": "ds",
  "standard": "WCAG 2.2 AA",
  "breakpoints": [
    {
      "name": "sm",
      "minWidth": 0,
      "ratio": 1.125
    },
    {
      "name": "md",
      "minWidth": 600,
      "ratio": 1.15
    },
    {
      "name": "lg",
      "minWidth": 1024,
      "ratio": 1.2
    },
    {
      "name": "xl",
      "minWidth": 1440,
      "ratio": 1.2
    }
  ],
  "modeSwitching": {
    "css": "media queries on min-width (no attribute needed)",
    "figma": "Set the Responsive collection mode (sm, md, lg, xl) on a frame"
  },
  "base": {
    "size": 16,
    "families": {
      "sans": "Inter, \"Segoe UI\", system-ui, -apple-system, sans-serif",
      "mono": "\"JetBrains Mono\", \"SFMono-Regular\", Consolas, monospace"
    },
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "letterSpacingEm": {
      "normal": 0,
      "tight": -0.01,
      "tighter": -0.02,
      "caps": 0.06
    }
  },
  "limits": {
    "minSize": 12,
    "readingLineHeight": 1.5,
    "minLineHeight": 1.15,
    "negativeTrackingFrom": 24,
    "measurePx": 544
  },
  "build": {
    "ok": true,
    "styles": 21,
    "checks": [
      {
        "id": "T1",
        "title": "In code, sizes are rem, line heights unitless and letter-spacing em — text follows the reader's text size",
        "status": "pass",
        "summary": "62/62 pass"
      },
      {
        "id": "T2",
        "title": "Reading text line height ≥ 1.5 at every breakpoint",
        "status": "pass",
        "summary": "32/32 pass"
      },
      {
        "id": "T3",
        "title": "Smallest text size ≥ 12px",
        "status": "pass",
        "summary": "84/84 pass"
      },
      {
        "id": "T4",
        "title": "Large / normal text class per breakpoint (sets the contrast each style needs)",
        "status": "info",
        "summary": "27 large, 57 normal"
      },
      {
        "id": "T5",
        "title": "Number styles use tabular numerals, so digits line up in columns",
        "status": "pass",
        "summary": "3/3 pass"
      },
      {
        "id": "T6",
        "title": "Every style's line height ≥ 1.15, so wrapped lines never touch",
        "status": "pass",
        "summary": "84/84 pass"
      },
      {
        "id": "T7",
        "title": "Hierarchy holds at every breakpoint: each role steps up, headings stay above titles, display above headings",
        "status": "pass",
        "summary": "64/64 pass"
      },
      {
        "id": "T8",
        "title": "Letter-spacing follows the size: no negative tracking below 24px, never tighter than −0.02em; capitals are spaced out",
        "status": "pass",
        "summary": "84/84 pass"
      },
      {
        "id": "T9",
        "title": "Running text width gives 45–75 characters a line at body sizes (estimate; the page audit measures real lines)",
        "status": "pass",
        "summary": "2/2 pass"
      },
      {
        "id": "L1",
        "title": "Reflow at 320px: content width ≥ 272px and largest heading ≤ 40px",
        "status": "pass",
        "summary": "2/2 pass"
      }
    ]
  },
  "rules": [
    {
      "id": "TR-01",
      "rule": "Use a text style for every piece of text. Never set font size, line height or letter-spacing by hand.",
      "why": "Styles carry the sizes for every breakpoint and line heights that are checked; a hand-set 15px carries neither.",
      "wcag": "—"
    },
    {
      "id": "TR-02",
      "rule": "Choose the style by what the text is, not by the size you want.",
      "why": "The size of a style changes with the screen; its job doesn't. Pick by job and the sizes follow.",
      "wcag": "—"
    },
    {
      "id": "TR-03",
      "rule": "Nothing smaller than 12px. Paragraphs, help text and code use reading styles (body, caption, code), which keep line height at 1.5 or more.",
      "why": "Small or cramped text is the first thing people with low vision or dyslexia lose.",
      "wcag": "1.4.12, 1.4.8"
    },
    {
      "id": "TR-04",
      "rule": "Numbers people compare — table columns, totals, metrics, timers — use tabular numerals: type.numeric.* or tabular-nums.",
      "why": "Proportional digits have different widths, so columns don't line up and values jump while they update.",
      "wcag": "—"
    },
    {
      "id": "TR-05",
      "rule": "Heading tags follow the page outline; styles follow the visual weight. Never skip a level (h2 → h4) to get a size.",
      "why": "Screen-reader users move through a page by heading level.",
      "wcag": "1.3.1, 2.4.6"
    },
    {
      "id": "TR-06",
      "rule": "At most one display style per view, and never for an app's page title (use type.heading.lg).",
      "why": "A second display competes with the first and flattens the hierarchy.",
      "wcag": "—"
    },
    {
      "id": "TR-07",
      "rule": "Never give text a fixed height. If you must truncate, the full text stays available (expand, tooltip on hover and focus, or a details view).",
      "why": "People enlarge text to 200% and override line and letter spacing; fixed boxes clip it.",
      "wcag": "1.4.4, 1.4.12"
    },
    {
      "id": "TR-08",
      "rule": "Keep running text within layout.measure.reading (about 70 characters a line).",
      "why": "On long lines readers lose their place when jumping to the next line.",
      "wcag": "1.4.8"
    },
    {
      "id": "TR-09",
      "rule": "Never block zoom (user-scalable=no, maximum-scale below 2) and never size text in px in code.",
      "why": "Zoom and the browser's text size are how many people read; px text ignores the text-size setting.",
      "wcag": "1.4.4"
    },
    {
      "id": "TR-10",
      "rule": "Emphasise with <strong> (semibold) or <em>. Underline is only for links; colour alone never carries emphasis.",
      "why": "Underlined words look like links; colour-only emphasis is invisible to some readers.",
      "wcag": "1.4.1"
    },
    {
      "id": "TR-11",
      "rule": "Capitals only for short labels (three words or fewer), using a style made for them (it adds letter-spacing). Never for sentences.",
      "why": "All-caps text is slower to read and loses word shapes.",
      "wcag": "—"
    },
    {
      "id": "TR-12",
      "rule": "Left-align running text (start-align in right-to-left languages). Never justify it.",
      "why": "Justified text leaves uneven gaps that make lines hard to follow.",
      "wcag": "1.4.8"
    },
    {
      "id": "TR-13",
      "rule": "Fonts come only from font.family.sans and font.family.mono. Never set a font-family in a component.",
      "why": "The family tokens carry a tested fallback stack, so text stays readable while fonts load; one place to change a brand font.",
      "wcag": "—"
    },
    {
      "id": "TR-14",
      "rule": "Design once with styles; the breakpoint changes the sizes (Responsive mode in Figma, media queries in code). Never swap to a \"mobile\" style by name.",
      "why": "The styles already shrink on small screens; swapping names breaks the hierarchy at other widths.",
      "wcag": "—"
    }
  ],
  "decisions": [
    {
      "what": "Text that names something",
      "question": "What does it name?",
      "answers": [
        [
          "The page's one big statement (landing, welcome, empty page)",
          "type.display.lg / type.display.md / type.display.sm"
        ],
        [
          "The page itself — its title (the h1)",
          "type.heading.lg"
        ],
        [
          "A section of the page",
          "type.heading.md"
        ],
        [
          "A subsection",
          "type.heading.sm"
        ],
        [
          "A dialog or side panel",
          "type.title.lg"
        ],
        [
          "A card or panel",
          "type.title.md"
        ],
        [
          "An item in a dense list, menu or table group",
          "type.title.sm"
        ]
      ]
    },
    {
      "what": "Text people read",
      "question": "Where does it sit?",
      "answers": [
        [
          "The intro under a page or section title",
          "type.body.lg"
        ],
        [
          "A paragraph or description",
          "type.body.md"
        ],
        [
          "Dense screens, text in table cells, secondary paragraphs",
          "type.body.sm"
        ],
        [
          "Help under a field, a timestamp, a footnote, chart labels",
          "type.caption.md"
        ]
      ]
    },
    {
      "what": "Text people act on",
      "question": "How dense is the screen?",
      "answers": [
        [
          "Buttons, field labels, tabs, menu items",
          "type.label.md"
        ],
        [
          "The same in comfortable density",
          "type.label.lg"
        ],
        [
          "Badges, chips, compact controls",
          "type.label.sm"
        ]
      ]
    },
    {
      "what": "A number",
      "question": "Will people compare it with others?",
      "answers": [
        [
          "Yes — a column in a table, a list of totals, a timer",
          "type.numeric.md (type.numeric.sm in compact tables)"
        ],
        [
          "The headline figure on a metric card",
          "type.numeric.lg"
        ],
        [
          "No — a number inside a sentence",
          "the sentence's own style (body …)"
        ]
      ]
    },
    {
      "what": "Code",
      "question": "What is around it?",
      "answers": [
        [
          "A code block, or inline code in body text",
          "type.code.md"
        ],
        [
          "Inline code in small text; IDs and keys in tables",
          "type.code.sm"
        ]
      ]
    },
    {
      "what": "A heading tag",
      "question": "Where is it in the page outline?",
      "answers": [
        [
          "Pick h1–h6 by the outline (never skip a level); pick the style by how much it should stand out",
          "any heading tag + any heading or title style"
        ],
        [
          "A title that is not a heading (a card label, a button)",
          "no heading tag; use the style on a div/span/button"
        ]
      ]
    }
  ],
